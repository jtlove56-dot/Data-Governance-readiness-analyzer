API_BASE_URL=http://127.0.0.1:8000
# Server-only; never use a secret or service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional canonical origin behind a trusted reverse proxy.
# Same-origin localhost, 127.0.0.1, and Vercel deployment URLs work without this.
APP_ORIGIN=
# Sign-in, sign-up and password attempts allowed per visitor, per route, per minute (default 10).
AUTH_RATE_LIMIT_PER_MINUTE=10

