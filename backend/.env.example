APP_ENV=development
APP_VERSION=0.1.0
MAX_REQUEST_BYTES=16384
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGIN_REGEX=https://data-governance-analyzer-[a-z0-9-]+-breezy1214s-projects\.vercel\.app
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate both keys with scripts/setup-local.ps1; never commit real values.
FRONTEND_SHARED_KEY=
SESSION_ENCRYPTION_KEY=
AUTH_DATABASE_PATH=.local/auth.sqlite3
AUTH_IDLE_SECONDS=1800
AUTH_MAX_SECONDS=28800
