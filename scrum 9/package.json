{
  "name": "karlsgate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @karlsgate/frontend dev",
    "dev:frontend": "pnpm --filter @karlsgate/frontend dev",
