{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Karlsgate: frontend dev",
      "type": "shell",
      "command": "pnpm --filter @karlsgate/frontend dev",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Karlsgate: backend dev",
      "type": "shell",
      "command": ".venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Karlsgate: frontend checks",
      "type": "shell",
      "command": "pnpm check",
      "problemMatcher": []
    },
    {
      "label": "Karlsgate: backend checks",
      "type": "shell",
      "command": ".venv/Scripts/python.exe -m ruff check .; .venv/Scripts/python.exe -m mypy app; .venv/Scripts/python.exe -m pytest",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    }
  ]
}
